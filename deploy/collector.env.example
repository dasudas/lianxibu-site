# Fictional local example. Supply real values through the runtime secret store.
SITE_BASE_URL=https://site.example.invalid
COLLECTOR_NODE_ID=example-node
COLLECTOR_TOKEN=replace-at-runtime
COLLECTOR_SQLITE_PATH=/var/lib/example/queue.sqlite
# Explicitly enable the durable collection loop after configuring the node.
COLLECTOR_ENABLED=false

# Host memory frames require native Linux proc and cgroup2 sources.
# Bind the managed service to the same controlled hard budget used by the backend.
COLLECTOR_HOST_MEMORY_ENABLED=false
