# Fictional local example. Supply real values through the runtime secret store.
SITE_DB_URL=jdbc:mysql://db.example.invalid:3306/example
SITE_DB_USER=example_user
SITE_DB_PASSWORD=replace-at-runtime
SITE_EXECUTION_ENABLED=false
SITE_SCHEDULER_ENABLED=false
SERVER_ADDRESS=127.0.0.1
# Optional local operational log delivery remains disabled unless all fields are configured.
SITE_OPS_DELIVERY_ENABLED=false
