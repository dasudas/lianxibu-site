# Fictional local example. Supply real values through the runtime secret store.
SITE_DB_URL=jdbc:mysql://db.example.invalid:3306/example
SITE_DB_USER=example_user
SITE_DB_PASSWORD=replace-at-runtime
SITE_EXECUTION_ENABLED=false
SITE_EXECUTION_WORKER_ENABLED=false
# Required only for the enabled AI worker; inject through host secret configuration.
# SITE_DEEPSEEK_API_KEY=replace-at-runtime
# Allow the original 90-second attempt deadline to finish during orderly shutdown.
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=120s
SITE_SCHEDULER_ENABLED=false
SITE_BROWSER_ENABLED=false
SITE_CONTENT_ENABLED=false
SITE_ARTICLES_ENABLED=false
SITE_SOURCES_ENABLED=false
SITE_COLLECTOR_ENABLED=false
# Formal release requires the original complete day roster and both execution loops.
SITE_SOURCES_DAY_ROSTER_ENABLED=false
SITE_EXECUTION_PREPARATION_ENABLED=false
# Process persisted version invalidations only after the content runtime is enabled.
SITE_CONTENT_PROPAGATION_ENABLED=false
# Exact external HTTPS origin (no trailing slash), and trusted database user IDs.
# The reverse proxy strips /api/business/v1 from browser requests.
SITE_BROWSER_ORIGIN=https://site.example.invalid
SITE_OWNER_IDS=fictional-owner-id
SITE_USER_IDS=
SERVER_ADDRESS=127.0.0.1
# Optional local operational log delivery remains disabled unless all fields are configured.
SITE_OPS_DELIVERY_ENABLED=false
# RDS sampling requires browser/collector runtimes and exact private resource scopes.
SITE_OPS_RDS_ENABLED=false
# Cloud notifications use a dedicated thread and a private file; log completion is independent.
SITE_OPS_CLOUD_ENABLED=false
# SITE_OPS_CLOUD_CONFIG=/etc/fictional-site/cloud-notification.json
# SITE_OPS_CLOUD_LEASE=PT60S
# SITE_OPS_CLOUD_RETRY=PT60S
# SITE_OPS_CLOUD_INTERVAL=PT10S
# SITE_OPS_CLOUD_BATCH=4
# SITE_RDS_MONITOR_CONFIG=/etc/fictional-site/rds-monitor.json
# SITE_OPERATIONAL_SCOPES=/etc/fictional-site/operational-scopes.json
# SITE_OPS_LOG_DIRECTORY=/var/log/fictional-site/operational
# SITE_OPS_LOG_SEGMENT_BYTES=8388608
# SITE_OPS_LOG_TOTAL_BYTES=268435456
# SITE_OPS_LOG_RETENTION=PT168H
# SITE_OPS_DELIVERY_LEASE=PT60S
# SITE_OPS_DELIVERY_RETRY=PT60S
# SITE_OPS_DELIVERY_INTERVAL=PT10S
# SITE_OPS_DELIVERY_BATCH=5

# Observe committed immutable versions for report cutoff proofs.
SITE_CONTENT_AVAILABILITY_ENABLED=false

SITE_EXECUTION_CATALOG_PREPARATION_ENABLED=false

SITE_EXECUTION_REPORT_PREPARATION_ENABLED=false

SITE_EXECUTION_REPORT_RUNTIME_ENABLED=false

SITE_EXECUTION_AD_HOC_ENABLED=false

SITE_LEARNING_ENABLED=false

# Operational providers require separately verified host files and native identities.
SITE_OPS_JAVA_MEMORY_ENABLED=false
SITE_OPS_RECOVERY_ENABLED=false
SITE_OPS_PROVIDER_ENABLED=false
SITE_OPS_SOURCE_CONTRACT_ENABLED=false
SITE_OPS_SOURCE_MONITORING_ENABLED=false
SITE_OPS_COLLECTOR_MONITORING_ENABLED=false
SITE_OPS_API_MONITORING_ENABLED=false
SITE_OPS_BACKLOG_MONITORING_ENABLED=false
SITE_OPS_COLLECTOR_MEMORY_ENABLED=false
# SITE_JAVA_MEMORY_BUDGET_CONFIG=/etc/fictional-site/java-memory-budget.json
# SITE_COLLECTOR_MONITOR_NODES=/etc/fictional-site/collector-monitor-nodes.json
# SITE_COLLECTOR_MEMORY_BUDGET=/etc/fictional-site/collector-memory-budget.json
# SITE_COLLECTOR_REVIEW_CATALOG=/etc/fictional-site/source-review-catalog.json
# SITE_API_MONITOR_RESOURCE=fictional-api-resource
# SITE_BACKLOG_MONITOR_RESOURCE=fictional-backlog-resource

