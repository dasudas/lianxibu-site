# Fictional local example. Supply real values through the runtime secret store.
SITE_DB_URL=jdbc:mysql://db.example.invalid:3306/example
SITE_DB_USER=example_user
SITE_DB_PASSWORD=replace-at-runtime
SITE_EXECUTION_ENABLED=false
SITE_SCHEDULER_ENABLED=false
SITE_BROWSER_ENABLED=false
# Exact external HTTPS origin (no trailing slash), and trusted database user IDs.
# The reverse proxy strips /api/business/v1 from browser requests.
SITE_BROWSER_ORIGIN=https://site.example.invalid
SITE_OWNER_IDS=fictional-owner-id
SITE_USER_IDS=
SERVER_ADDRESS=127.0.0.1
# Optional local operational log delivery remains disabled unless all fields are configured.
SITE_OPS_DELIVERY_ENABLED=false
# SITE_OPS_LOG_DIRECTORY=/var/log/fictional-site/operational
# SITE_OPS_LOG_SEGMENT_BYTES=8388608
# SITE_OPS_LOG_TOTAL_BYTES=268435456
# SITE_OPS_LOG_RETENTION=PT168H
# SITE_OPS_DELIVERY_LEASE=PT60S
# SITE_OPS_DELIVERY_RETRY=PT60S
# SITE_OPS_DELIVERY_INTERVAL=PT10S
# SITE_OPS_DELIVERY_BATCH=5
