{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lianxibu:source-contract-telemetry:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "config_version",
    "epoch",
    "sequence",
    "observed_at",
    "window_start",
    "total_failures",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "source-contract-telemetry-v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "config_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "total_failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "occurred_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
          }
        }
      }
    }
  },
  "description": "Complete authenticated collector-native failure window. Cross-field invariants and immutable replay are checked by both runtimes. Maximum raw body: 32768 bytes. Window length: exactly 600 seconds. Existing heartbeat and observation protocols are unchanged."
}
