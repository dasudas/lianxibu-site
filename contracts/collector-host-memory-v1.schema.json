{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lianxibu:collector-host-memory:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_epoch",
    "process_identity",
    "capture_started_at",
    "sequence",
    "pid",
    "observed_at",
    "rss_bytes",
    "cgroup_epoch",
    "maximum_bytes",
    "oom_events",
    "oom_kills"
  ],
  "properties": {
    "schema_version": {
      "const": "collector-host-memory-v1"
    },
    "capture_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "process_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture_started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "rss_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cgroup_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maximum_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "oom_events": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "oom_kills": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_epoch",
        "sequence",
        "payload_hash",
        "received_at"
      ],
      "properties": {
        "capture_epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        }
      }
    }
  },
  "description": "Independent authenticated native host-memory snapshot. Maximum raw body: 8192 bytes. Cross-field lifetime/freshness, exact numeric tokens, authorization, replay and controlled host-budget checks are runtime requirements."
}
