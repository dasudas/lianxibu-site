{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lianxibu:catalog-dedup-result:2",
  "$ref": "#/$defs/CatalogDedupResultV2",
  "$defs": {
    "CatalogVersionEvidenceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "catalog_version_evidence"
        },
        "proof_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "kind",
        "proof_hash"
      ],
      "additionalProperties": false
    },
    "CatalogDedupDecisionV2": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "category": {
          "type": "string",
          "enum": [
            "agent",
            "skill",
            "workflow",
            "model"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "new",
            "existing",
            "needs_review"
          ]
        },
        "candidate_entity_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "confidence": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]{1,8})?|1(\\.0{1,8})?)$(?![\\s\\S])"
        },
        "suggested_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "suggested_summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "reanalyze_recommended": {
          "type": "boolean"
        },
        "version_changed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "previous_evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogVersionEvidenceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogVersionEvidenceRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item_id",
        "category",
        "decision",
        "candidate_entity_id",
        "reason",
        "confidence",
        "suggested_title",
        "suggested_summary",
        "reanalyze_recommended",
        "version_changed",
        "previous_evidence_ref",
        "new_evidence_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "existing"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "candidate_entity_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              }
            }
          },
          "else": {
            "properties": {
              "version_changed": {
                "type": "null"
              },
              "previous_evidence_ref": {
                "type": "null"
              },
              "new_evidence_ref": {
                "type": "null"
              },
              "reanalyze_recommended": {
                "const": false
              },
              "candidate_entity_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version_changed": {
                "type": "null"
              }
            },
            "required": [
              "version_changed"
            ]
          },
          "then": {
            "properties": {
              "version_changed": {
                "type": "null"
              },
              "previous_evidence_ref": {
                "type": "null"
              },
              "new_evidence_ref": {
                "type": "null"
              },
              "reanalyze_recommended": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "previous_evidence_ref": {
                "$ref": "#/$defs/CatalogVersionEvidenceRef"
              },
              "new_evidence_ref": {
                "$ref": "#/$defs/CatalogVersionEvidenceRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version_changed": {
                "const": false
              }
            },
            "required": [
              "version_changed"
            ]
          },
          "then": {
            "properties": {
              "reanalyze_recommended": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reanalyze_recommended": {
                "const": true
              }
            },
            "required": [
              "reanalyze_recommended"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "const": "existing"
              },
              "version_changed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "CatalogDedupResultV2": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "dedup"
        },
        "dedup_result_version": {
          "const": "2"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogDedupDecisionV2"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        }
      },
      "required": [
        "kind",
        "dedup_result_version",
        "items",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
