{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lianxibu:news-value-result:2",
  "$ref": "#/$defs/ValueResultV2",
  "$defs": {
    "ValueDecisionV2": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "category": {
          "type": "string",
          "enum": [
            "news_tech",
            "agent",
            "skill",
            "workflow",
            "model"
          ]
        },
        "high_value": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "valuable": {
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "category",
        "high_value",
        "reason",
        "valuable"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "high_value": {
                "const": true
              }
            },
            "required": [
              "high_value"
            ]
          },
          "then": {
            "properties": {
              "valuable": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "ValueResultV2": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "value"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValueDecisionV2"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "selected_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "value_result_version": {
          "const": "2"
        }
      },
      "required": [
        "kind",
        "items",
        "selected_item_ids",
        "summary",
        "value_result_version"
      ],
      "additionalProperties": false
    }
  }
}
